rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos de cada cuenta: el dueño y los relojes que vinculó
    match /accounts/{acc} {
      allow create: if request.auth != null && request.auth.uid == acc;
      allow read: if request.auth != null && (request.auth.uid == acc || request.auth.uid in resource.data.get('members', []));
      allow update: if request.auth != null && (request.auth.uid == acc ||
        (request.auth.uid in resource.data.get('members', []) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'at'])));
      // El dueño puede eliminar su cuenta y sus datos (requisito de Google Play)
      allow delete: if request.auth != null && request.auth.uid == acc;
    }
    // Reportes de errores anónimos: solo se pueden crear (nadie los lee desde la app).
    // En Firestore → TTL, activar la política sobre el campo `exp` para borrarlos a los 90 días.
    match /errors/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['m', 's', 'l', 'st', 'v', 'p', 'ua', 'at', 'exp'])
        && request.resource.data.m is string && request.resource.data.m.size() <= 400
        && request.resource.data.st is string && request.resource.data.st.size() <= 1500
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200;
      allow read, update, delete: if false;
    }
    // Fase 4 · Amigos y entrenador
    // Resumen semanal público para amigos (nombre y números de la semana). Solo get: no se pueden listar.
    match /social/{acc} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == acc
        && request.resource.data.keys().hasOnly(['name', 'j', 'at']) && request.resource.data.j.size() <= 4000;
      allow delete: if request.auth != null && request.auth.uid == acc;
    }
    // Código de 6 letras → cuenta. Se crea una vez y no se puede sobrescribir.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.acc == request.auth.uid;
      allow delete: if request.auth != null && resource.data.acc == request.auth.uid;
    }
    // Progreso que el alumno comparte con sus entrenadores
    match /share/{acc} {
      allow get: if request.auth != null && (request.auth.uid == acc || request.auth.uid in resource.data.trainers);
      allow create, update: if request.auth != null && request.auth.uid == acc && request.resource.data.trainers is list;
      allow delete: if request.auth != null && request.auth.uid == acc;
    }
    // Bandeja: avisos de alumnos nuevos (cualquiera) y rutinas (solo entrenadores autorizados)
    match /inbox/{acc}/items/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == acc;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && (
        request.resource.data.type == 'client' ||
        (request.resource.data.type == 'plan' && request.resource.data.j.size() <= 200000 &&
          request.auth.uid in get(/databases/$(database)/documents/share/$(acc)).data.trainers));
    }
    // Códigos temporales para vincular un reloj
    match /pairs/{code} {
      allow create: if request.auth != null && request.resource.data.watch == request.auth.uid;
      allow get: if request.auth != null;
      allow update: if request.auth != null && request.resource.data.acc == request.auth.uid && request.resource.data.watch == resource.data.watch;
      allow delete: if request.auth != null && resource.data.watch == request.auth.uid;
    }
  }
}
